# Required
GEMINI_API_KEY=

# Optional providers (only if you extend workflow.py to use them)
OPENROUTER_API_KEY=
HUGGINGFACE_API_KEY=
NVIDIA_API_KEY=

# Optional long-term memory
TURSO_URL=
TURSO_AUTH_TOKEN=

# Optional shared secret between Node gateway and this service.
# If set, requests without matching Authorization: Bearer <secret> are rejected.
GATEWAY_SHARED_SECRET=

# Server
HOST=0.0.0.0
PORT=8080
DEFAULT_PROVIDER=gemini
DEFAULT_MODEL=gemini-1.5-flash
